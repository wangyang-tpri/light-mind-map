{
  "name": "MindSprout",
  "displayName": "知枝 · MindSprout",
  "description": "知枝 · MindSprout：轻量级思维导图编辑器，支持 Markdown 右侧实时预览、表格、代码、Mermaid、多种布局与关联线，导出 SVG / HTML / PNG。",
  "version": "0.1.18",
  "publisher": "wangyang-tpri",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:mindsprout.editor",
    "onCommand:mindsprout.new",
    "onCommand:mindsprout.markdownPreview",
    "onCommand:mindsprout.newInFolder"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mindsprout.new",
        "title": "New MindSprout"
      },
      {
        "command": "mindsprout.markdownPreview",
        "title": "MindSprout",
        "category": "Markdown",
        "icon": "$(preview)"
      },
      {
        "command": "mindsprout.newInFolder",
        "title": "New MindSprout"
      }
    ],
    "customEditors": [
      {
        "viewType": "mindsprout.editor",
        "displayName": "思维导图",
        "selector": [
          {
            "filenamePattern": "*.mindmap"
          },
          {
            "filenamePattern": "*.mindm"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mindsprout.newInFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "mindsprout.new"
        },
        {
          "command": "mindsprout.newInFolder",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "mindsprout.markdownPreview",
          "when": "editorLangId == markdown || resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mindsprout.new",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      }
    ],
    "configuration": {
      "title": "知枝 · MindSprout",
      "properties": {
        "mindmap.defaultTheme": {
          "type": "string",
          "enum": [
            "lightMap",
            "fresh",
            "night"
          ],
          "enumDescriptions": [
            "科技蓝（默认）",
            "清新绿",
            "深色夜间"
          ],
          "default": "lightMap",
          "description": "新打开思维导图时使用的默认主题"
        }
      }
    }
  },
  "scripts": {
    "compile": "node scripts/vendor.js && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "test": "npm run compile && node test/core.test.js && node test/webview.smoke.test.js && node test/markdown-preview.test.js",
    "test:browser": "node test/rich.browser.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "jsdom": "^29.1.1",
    "mermaid": "^12.2.0",
    "typescript": "^5.4.0"
  },
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangyang-tpri/light-mind-map.git"
  }
}
